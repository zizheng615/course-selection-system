# 复制为 .env 后按需填写。.env 已被 .gitignore 忽略，不会进入提交物。
# 所有变量都有安全默认值，不填也能正常运行（AI 助手退化为纯本地知识库）。

# ---------- JWT ----------
# 生产部署必须替换为随机长字符串（>=32 字节）。留空则使用公开的演示默认值。
JWT_SECRET=
JWT_EXPIRE_HOURS=24

# ---------- AI 助手（可选）----------
# 留空则大模型提供方不可用，系统只走内置知识库。
# 严禁把真实 Key 写进代码或提交到仓库。
AI_ENABLED=true
AI_API_KEY=
AI_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-5-5
AI_PROVIDER_NAME=Claude
AI_TIMEOUT_SECONDS=30

# ---------- 其它 ----------
DB_PATH=
DEFAULT_SEMESTER=2026-2027-1
DEFAULT_PASSWORD=123456
